<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean id="griddednucaps-camel-clustered" factory-bean="routeContextFactory" factory-method="createClustered">
        <constructor-arg>
            <bean class="gov.noaa.nws.sti.mdl.edex.plugin.griddednucaps.GriddednucapsCamelClusteredRoutes">
                <constructor-arg name="aggregationStrategy" ref="timeBasedAggStrategy" />
                <constructor-arg name="aggregateProcessorId" value="griddednucapsAggProcessor" />
            </bean>
        </constructor-arg>
    </bean>
</beans>
